<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.GamingTeamFinder" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.GamingTeamFinder" parent="Base.Theme.GamingTeamFinder" />

    <style name="Theme.GamingTeamFinder.Starting"
        parent="Theme.SplashScreen.IconBackground">

        <!-- Main Splash Screen background -->
        <item name="windowSplashScreenBackground">
            #313172
        </item>

        <!-- Logo background: same as main background -->
        <item name="windowSplashScreenIconBackgroundColor">
            #313172
        </item>

        <!-- GTF Logo -->
        <item name="windowSplashScreenAnimatedIcon">
            @drawable/gtf_splash_colorful_safe
        </item>

        <item name="postSplashScreenTheme">
            @style/Theme.GamingTeamFinder
        </item>

    </style>
</resources>