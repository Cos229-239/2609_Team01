<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EDE3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#F5EDE3"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="35dp"
        android:paddingBottom="35dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#F5EDE3"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:paddingTop="35dp"
            android:paddingBottom="35dp">

            <ImageView
                android:id="@+id/imageLogo"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:src="@drawable/logo_team"
                android:scaleType="centerInside"
                android:adjustViewBounds="true"
                android:contentDescription="Gaming Team Finder Logo"
                android:layout_marginBottom="26dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Find your squad.\nPlay Together."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#444444"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_marginBottom="42dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRiotLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Sign in with Riot account"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#222222"
                android:textSize="13sp"
                android:backgroundTint="#D9D9D9"
                android:layout_marginBottom="14dp"

                app:cornerRadius="26dp"
                app:icon="@drawable/riot_logo"
                app:iconSize="22dp"
                app:iconPadding="10dp"
                app:iconGravity="textStart"
                app:iconTint="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OR"
                android:textSize="12sp"
                android:textColor="#555555"
                android:layout_marginBottom="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGoogleLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Sign in with Google"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#222222"
                android:textSize="13sp"
                android:backgroundTint="#D9D9D9"
                android:layout_marginBottom="14dp"

                app:cornerRadius="26dp"
                app:icon="@drawable/google_g"
                app:iconSize="22dp"
                app:iconPadding="10dp"
                app:iconGravity="textStart"
                app:iconTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEmailLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Create account with e-mail"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#222222"
                android:textSize="13sp"
                android:backgroundTint="#D9D9D9"

                app:cornerRadius="26dp"
                app:icon="@drawable/email_icon"
                app:iconSize="22dp"
                app:iconPadding="10dp"
                app:iconGravity="textStart"
                app:iconTint="@null" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>