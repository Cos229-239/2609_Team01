
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/login_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="28dp">

        <!-- Icon -->
        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:padding="22dp"
            android:src="@drawable/ic_account_password"
            android:background="@drawable/bg_settings_icon"
            android:contentDescription="Reset Password"
            android:layout_marginBottom="24dp" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset Your Password"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter and confirm your new password."
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <!-- Password Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/bg_settings_card">

            <!-- New Password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="New Password"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#30364F"
                android:layout_marginBottom="10dp" />


            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:endIconMode="password_toggle"
                app:endIconTint="#376DA4">

                <EditText
                    android:id="@+id/editNewResetPassword"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="Enter new password"
                    android:inputType="textPassword"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:textColor="#30364F"
                    android:background="@drawable/bg_settings_icon" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Confirm Password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirm New Password"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#30364F"
                android:layout_marginBottom="10dp" />


            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:endIconMode="password_toggle"
                app:endIconTint="#376DA4">

                <EditText
                    android:id="@+id/editConfirmResetPassword"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="Confirm new password"
                    android:inputType="textPassword"
                    android:padding="14dp"
                    android:singleLine="true"
                    android:textColor="#30364F"
                    android:background="@drawable/bg_settings_icon" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- Update Password -->
            <!-- Password Reset Countdown -->
            <TextView
                android:id="@+id/textResetPasswordCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:text="Time Remaining: 05:00"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#B3261E"
                android:gravity="center" />

            <Button
                android:id="@+id/buttonConfirmResetPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Update Password"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#376DA4"
                android:enabled="false" />

            <!-- Success Message -->
            <TextView
                android:id="@+id/textResetPasswordSuccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Password Changed Successfully!"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#23744B"
                android:gravity="center"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Back to Login -->
        <TextView
            android:id="@+id/buttonResetBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Back to Login"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</ScrollView>
