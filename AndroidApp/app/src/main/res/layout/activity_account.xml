
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#EEF1FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/buttonAccountBack"
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="←"
                android:textSize="28sp"
                android:textColor="#30364F"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Account"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#30364F" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your account information and security."
            android:textSize="14sp"
            android:textColor="#747887"
            android:layout_marginBottom="26dp" />

        <!-- Change Email -->
        <LinearLayout
            android:id="@+id/accountChangeEmail"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_settings_card">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_account_email"
                app:tint="#6C4FB3"
                android:background="@drawable/bg_settings_icon"
                android:contentDescription="Email icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change Email"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#30364F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Update your login email"
                    android:textSize="12sp"
                    android:textColor="#747887" />
            </LinearLayout>

            <TextView
                android:layout_width="22dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="›"
                android:textSize="28sp"
                android:textColor="#747887" />

        </LinearLayout>

        <!-- Change Password -->
        <LinearLayout
            android:id="@+id/accountChangePassword"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_settings_card">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_account_password"
                app:tint="#6C4FB3"
                android:background="@drawable/bg_settings_icon"
                android:contentDescription="Password icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change Password"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#30364F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Manage your account security"
                    android:textSize="12sp"
                    android:textColor="#747887" />
            </LinearLayout>

            <TextView
                android:layout_width="22dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="›"
                android:textSize="28sp"
                android:textColor="#747887" />

        </LinearLayout>

        <!-- Riot Account -->
        <LinearLayout
            android:id="@+id/accountRiot"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_settings_card">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_account_riot"
                app:tint="#6C4FB3"
                android:background="@drawable/bg_settings_icon"
                android:contentDescription="Riot Account icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Riot Account"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#30364F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Manage your Riot ID"
                    android:textSize="12sp"
                    android:textColor="#747887" />
            </LinearLayout>

            <TextView
                android:layout_width="22dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="›"
                android:textSize="28sp"
                android:textColor="#747887" />

        </LinearLayout>

        <!-- Log Out -->
        <LinearLayout
            android:id="@+id/accountLogout"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_settings_card">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_account_logout"
                app:tint="#C84545"
                android:background="@drawable/bg_settings_icon"
                android:contentDescription="Log Out icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log Out"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#C84545" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Sign out of Gaming Team Finder"
                    android:textSize="12sp"
                    android:textColor="#747887" />
            </LinearLayout>

            <TextView
                android:layout_width="22dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="›"
                android:textSize="28sp"
                android:textColor="#747887" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
