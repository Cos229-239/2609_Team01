
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@drawable/bg_logout_dialog">

    <!-- Email Warning Icon -->
    <ImageView
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:padding="20dp"
        android:src="@drawable/ic_account_email"
        android:background="@drawable/bg_settings_icon"
        app:tint="#6C4FB3"
        android:contentDescription="Email Not Verified"
        android:layout_marginBottom="24dp" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email Not Verified"
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="#30364F"
        android:gravity="center"
        android:layout_marginBottom="18dp" />

    <!-- Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your registration is not complete. Please verify your email address to continue."
        android:textSize="14sp"
        android:textColor="#747887"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="22dp" />

    <!-- Verify Button -->
    <TextView
        android:id="@+id/buttonVerifyFromLogin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:text="Verify My Email"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_logout_button"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp" />

    <!-- Not Now Button -->
    <TextView
        android:id="@+id/buttonNotNow"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:text="Not Now"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#6C4FB3"
        android:background="@drawable/bg_logout_button_outline"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
