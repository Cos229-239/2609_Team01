<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="55dp"
        android:paddingBottom="40dp">



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp"
            android:layout_gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="#3D5775"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textSignIn"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:background="@drawable/clickable_text_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in"
                android:textColor="#1E5AA8"
                android:textStyle="bold"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gamer Tag"
            android:textStyle="bold"
            android:textColor="#3D5775"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editGamerTag"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Enter gamer tag"
            android:padding="14dp"
            android:background="#EEFFFFFF"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textStyle="bold"
            android:textColor="#3D5775"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editSignUpEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Enter your email"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:background="#EEFFFFFF"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textStyle="bold"
            android:textColor="#3D5775"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editSignUpPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Create password"
            android:inputType="textPassword"
            android:padding="14dp"
            android:background="#EEFFFFFF"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirm Password"
            android:textStyle="bold"
            android:textColor="#3D5775"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Repeat password"
            android:inputType="textPassword"
            android:padding="14dp"
            android:background="#EEFFFFFF"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/buttonSignUp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="SIGN UP"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#376DA4" />

    </LinearLayout>

</ScrollView>