<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="36dp"
        android:paddingRight="36dp"
        android:paddingTop="80dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/buttonBackToWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#5B2A86"
            android:gravity="start"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:translationY="-10dp"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/imageLoginLogo"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/gtf_welcome_logo"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="Gaming Team Finder Logo"
            android:layout_marginBottom="12dp" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Login"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textStyle="bold"
            android:textColor="#3D5775"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Enter your email"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:background="#EEFFFFFF"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textStyle="bold"
            android:textColor="#3D5775"
            android:layout_marginBottom="6dp" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxBackgroundMode="none"
            app:hintEnabled="false"
            app:endIconMode="password_toggle"
            app:endIconTint="#496987">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Enter your password"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="#EEFFFFFF"
                android:textColor="#1F2430"
                android:textColorHint="#A0A0A0" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- Remember Me and Forgot Password -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/checkRememberMe"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Remember me"
                    android:textColor="#496987" />

                <TextView
                    android:id="@+id/textForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:background="@drawable/clickable_text_background"
                    android:text="Forgot Password?"
                    android:textColor="#496987"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Remember Me Warning -->
            <TextView
                android:id="@+id/textRememberWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Without Remember Me, you'll need to sign in again the next time you open the app. Tap LOGIN again to continue."
                android:textSize="12sp"
                android:textColor="#8A5A17"
                android:lineSpacingExtra="3dp"
                android:visibility="gone" />

        </LinearLayout>


        <Button
            android:id="@+id/buttonLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="LOGIN"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#376DA4"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Don't have an account?"
            android:textColor="#496987"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/buttonCreateAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:background="@drawable/clickable_text_background"
            android:textStyle="bold"
            android:textColor="#376DA4"
            android:backgroundTint="#00FFFFFF" />

    </LinearLayout>

</ScrollView>