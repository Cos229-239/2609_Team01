
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="40dp">


        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Email Icon -->
            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:padding="22dp"
                android:src="@drawable/ic_email_verified"
                android:background="@drawable/bg_settings_icon"
                app:tint="#376DA4"
                android:contentDescription="Password Reset"
                android:layout_marginBottom="24dp" />

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Forgot Password?"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter your email to receive a 6-digit verification code."
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="30dp" />

            <!-- Reset Password Form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp"
                android:background="@drawable/bg_settings_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email Address"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#30364F"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/editResetEmail"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="Enter your email"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="14sp"
                    android:textColor="#30364F"
                    android:textColorHint="#9398A5"
                    android:background="@drawable/bg_settings_icon"
                    android:layout_marginBottom="22dp" />

                <!-- OTP Limit Countdown -->
                <TextView
                    android:id="@+id/textOtpLimitCountdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="Next OTP available in 24:00:00"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#B3261E"
                    android:gravity="center"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/buttonSendOtp"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Send OTP"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#006B68" />







            </LinearLayout>

            <!-- Return to Login -->
            <TextView
                android:id="@+id/textReturnToLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Back to Login"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#376DA4"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
