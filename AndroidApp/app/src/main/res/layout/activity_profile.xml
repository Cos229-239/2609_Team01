<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF1FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <Button
                android:id="@+id/buttonBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Back"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/textAvatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:text=""
                android:textSize="24sp"
                android:textStyle="bold"
                android:background="@drawable/friend_avatar_background"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/textDisplayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kien Plays"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:id="@+id/textRegion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="North America · English"
                android:textSize="14sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chill but competitive. Looking for reliable teammates."
                android:textSize="16sp"
                android:padding="16dp"
                android:background="@drawable/profile_card_background"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Main Game"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/profile_card_background"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/textGame"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="League of Legends"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/textRiotId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Example#NA1"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/textRank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gold IV"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/textRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mid / Support" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Play Style"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textAvailability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Team-focused · Voice chat · Evenings"
                android:textSize="16sp"
                android:padding="16dp"
                android:background="@drawable/profile_card_background"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/buttonEditProfile"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="EDIT PROFILE"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6C4FB3"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#D9E1F2">

        <Button
            android:id="@+id/buttonNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⌂"
            android:textSize="28sp"
            android:backgroundTint="#00FFFFFF"
            android:textColor="#7B8193" />

        <Button
            android:id="@+id/buttonNavSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🔍"
            android:textSize="24sp"
            android:backgroundTint="#00FFFFFF"
            android:textColor="#7B8193" />

        <Button
            android:id="@+id/buttonNavMessages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="💬"
            android:textSize="24sp"
            android:backgroundTint="#00FFFFFF"
            android:textColor="#7B8193" />

        <Button
            android:id="@+id/buttonNavProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="👤"
            android:textSize="24sp"
            android:backgroundTint="#00FFFFFF"
            android:textColor="#4F35A5" />

    </LinearLayout>

</LinearLayout>