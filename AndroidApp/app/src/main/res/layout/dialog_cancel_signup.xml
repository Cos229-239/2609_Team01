<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@drawable/bg_logout_dialog">

    <!-- Icon -->
    <ImageView
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:padding="20dp"
        android:src="@drawable/ic_account_logout"
        android:background="@drawable/bg_settings_icon"
        android:contentDescription="Cancel Sign Up"
        android:layout_marginBottom="24dp" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel Sign Up?"
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="#30364F"
        android:gravity="center"
        android:layout_marginBottom="18dp" />

    <!-- Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your unverified account will be deleted. Are you sure you want to cancel your registration?"
        android:textSize="14sp"
        android:textColor="#747887"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="22dp" />

    <!-- Keep Signing Up -->
    <TextView
        android:id="@+id/buttonKeepSigningUp"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:text="Keep Signing Up"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_logout_button"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp" />

    <!-- Confirm Cancel -->
    <TextView
        android:id="@+id/buttonConfirmCancelSignup"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center"
        android:text="Cancel Sign Up"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#6C4FB3"
        android:background="@drawable/bg_logout_button_outline"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
