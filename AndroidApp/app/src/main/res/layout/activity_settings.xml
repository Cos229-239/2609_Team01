
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF1FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="26dp">

                <TextView
                    android:id="@+id/buttonSettingsBack"
                    android:layout_width="36dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="←"
                    android:textSize="28sp"
                    android:textColor="#30364F"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Settings"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#30364F" />

            </LinearLayout>

            <!-- Account -->
            <LinearLayout
                android:id="@+id/settingsAccount"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_settings_card">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings_account"
                    android:background="@drawable/bg_settings_icon"
                    app:tint="#6C4FB3"
                    android:contentDescription="Account icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Account"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#30364F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Email, password and Riot account"
                        android:textSize="12sp"
                        android:textColor="#747887" />
                </LinearLayout>

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="#747887" />

            </LinearLayout>

            <!-- Notifications -->
            <LinearLayout
                android:id="@+id/settingsNotifications"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_settings_card">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings_notifications"
                    android:background="@drawable/bg_settings_icon"
                    app:tint="#6C4FB3"
                    android:contentDescription="Notifications icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notifications"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#30364F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Manage your notifications"
                        android:textSize="12sp"
                        android:textColor="#747887" />
                </LinearLayout>

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="#747887" />

            </LinearLayout>

            <!-- Audio & Chat -->
            <LinearLayout
                android:id="@+id/settingsAudioChat"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_settings_card">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings_audio"
                    android:background="@drawable/bg_settings_icon"
                    app:tint="#6C4FB3"
                    android:contentDescription="Audio and Chat icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Audio &amp; Chat"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#30364F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Chat and sound preferences"
                        android:textSize="12sp"
                        android:textColor="#747887" />
                </LinearLayout>

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="#747887" />

            </LinearLayout>

            <!-- Display -->
            <LinearLayout
                android:id="@+id/settingsDisplay"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_settings_card">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings_display"
                    android:background="@drawable/bg_settings_icon"
                    app:tint="#6C4FB3"
                    android:contentDescription="Display icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Display"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#30364F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Appearance and theme"
                        android:textSize="12sp"
                        android:textColor="#747887" />
                </LinearLayout>

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="#747887" />

            </LinearLayout>

            <!-- Help & Support -->
            <LinearLayout
                android:id="@+id/settingsHelp"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_settings_card">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings_help"
                    android:background="@drawable/bg_settings_icon"
                    app:tint="#6C4FB3"
                    android:contentDescription="Help and Support icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Help &amp; Support"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#30364F" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Get help and information"
                        android:textSize="12sp"
                        android:textColor="#747887" />
                </LinearLayout>

                <TextView
                    android:layout_width="22dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="›"
                    android:textSize="28sp"
                    android:textColor="#747887" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
