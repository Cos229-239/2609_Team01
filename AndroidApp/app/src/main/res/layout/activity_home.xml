<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF1FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Home"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                <FrameLayout
                    android:id="@+id/notificationContainer"
                    android:layout_width="52dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp">

                    <ImageView
                        android:id="@+id/buttonNotifications"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_notification"
                        app:tint="#6B6B75"
                        android:contentDescription="Notifications" />

                    <TextView
                        android:id="@+id/textNotificationBadge"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:gravity="center"
                        android:text=""
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:background="@drawable/notification_badge_background"
                        android:visibility="visible" />

                </FrameLayout>

                <ImageView
                    android:id="@+id/buttonFriends"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_friends"
                    app:tint="#6B6B75"
                    android:contentDescription="Friends" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Friends"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:layout_marginBottom="28dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/friendsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Actions"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/buttonFindTeam"
                    android:layout_width="0dp"
                    android:layout_height="78dp"
                    android:layout_weight="1"
                    android:text="Find Team"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:backgroundTint="#6C4FB3"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp" />
                <Button
                    android:id="@+id/buttonFindDuo"
                    android:layout_width="0dp"
                    android:layout_height="78dp"
                    android:layout_weight="1"
                    android:text="Find Duo"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:backgroundTint="#6C4FB3"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonFindPlayers"
                    android:layout_width="0dp"
                    android:layout_height="78dp"
                    android:layout_weight="1"
                    android:text="Players/Teams"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:backgroundTint="#6C4FB3"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/buttonTeam"
                    android:layout_width="0dp"
                    android:layout_height="78dp"
                    android:layout_weight="1"
                    android:text="Create Team"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:backgroundTint="#6C4FB3"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#D9E1F2">

        <ImageButton
            android:id="@+id/buttonHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_nav_home"
            android:background="@android:color/transparent"
            android:scaleType="center"
            app:tint="#6C4FB3"
            android:contentDescription="Home" />

        <ImageButton
            android:id="@+id/buttonSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_nav_search"
            android:background="@android:color/transparent"
            android:scaleType="center"
            app:tint="#6B6B75"
            android:contentDescription="Search" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/buttonMessages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_nav_messages"
                android:background="@android:color/transparent"
                android:scaleType="center"
                app:tint="#6B6B75"
                android:contentDescription="Messages" />

            <TextView
                android:id="@+id/textMessageBadge"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:minWidth="22dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp"
                android:translationX="18dp"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:background="@drawable/notification_badge_background"
                android:visibility="gone"
                android:clickable="false"
                android:focusable="false" />

        </FrameLayout>

        <ImageButton
            android:id="@+id/buttonProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_nav_profile"
            android:background="@android:color/transparent"
            android:scaleType="center"
            app:tint="#6B6B75"
            android:contentDescription="Profile" />

    </LinearLayout>
</LinearLayout>